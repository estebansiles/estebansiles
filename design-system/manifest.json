  "components": [
    {
      "name": "Boton",
      "group": "Acciones",
      "summary": "Botón principal de la marca (radio-sm, Poppins 500); úsalo para llamadas a la acción con verbo en imperativo."
    },
    {
      "name": "BotonIcono",
      "group": "Acciones",
      "summary": "Botón de ícono para menú, cerrar, descargar."
    },
    {
      "name": "Enlace",
      "group": "Acciones",
      "summary": "Enlace de acción en accion con subrayado de 1px y flecha que avanza al pasar el cursor."
    },
    {
      "name": "Cotizacion",
      "group": "Contenido",
      "summary": "Tabla de cotización: encabezados en etiqueta, números tabulares a la derecha, IVA 13 % en fila aparte."
    },
    {
      "name": "Estado",
      "group": "Contenido",
      "summary": "Etiqueta de estado compacta (radio-sm) para cotizaciones, proyectos y tareas."
    },
    {
      "name": "Ficha",
      "group": "Contenido",
      "summary": "Ficha (chip) seleccionable para filtrar servicios o casos."
    },
    {
      "name": "Monto",
      "group": "Contenido",
      "summary": "Formatea montos según la marca (moneda + espacio fino como separador de miles)."
    },
    {
      "name": "Seccion",
      "group": "Contenido",
      "summary": "Contenedor de sección de página (sl-seccion + sl-contenedor); úsalo para cada bloque de una página o propuesta."
    },
    {
      "name": "Tarjeta",
      "group": "Contenido",
      "summary": "Tarjeta recta con filete para servicios, casos y pasos de proceso."
    },
    {
      "name": "Titulo",
      "group": "Contenido",
      "summary": "Título de bloque con antetítulo opcional y la firma de la marca; úsalo para abrir cada sección (uno con firma por bloque)."
    },
    {
      "name": "Campo",
      "group": "Formularios",
      "summary": "Campo de formulario (alto 44px, radio-sm, Lato Regular) para contacto y cotización."
    },
    {
      "name": "Casilla",
      "group": "Formularios",
      "summary": "Casilla (checkbox) o radio con etiqueta clicable."
    },
    {
      "name": "Interruptor",
      "group": "Formularios",
      "summary": "Interruptor para ajustes que aplican al instante (p. ej. tema oscuro)."
    },
    {
      "name": "Selector",
      "group": "Formularios",
      "summary": "Selector desplegable nativo."
    },
    {
      "name": "Icono",
      "group": "Marca",
      "summary": "Ícono de la serie propia Siles (37 glifos); úsalo en servicios, botones y listas — nunca mezclado con otras familias ni con emojis."
    },
    {
      "name": "Logo",
      "group": "Marca",
      "summary": "Logo de Siles Comunicación en SVG; úsalo completo siempre que quepa y el isotipo en avatares, favicon y barras de aplicación."
    },
    {
      "name": "Patron",
      "group": "Marca",
      "summary": "Patrón de red de Siles como fondo de portada (hero, portada de propuesta o de presentación); una sola vez por pieza, con el texto dentro de un bloque liso."
    },
    {
      "name": "Franja",
      "group": "Marca",
      "summary": "Banda de ancho completo con degradado de marca o motivo gráfico; el contenido va en un bloque liso."
    },
    {
      "name": "Imagen",
      "group": "Marca",
      "summary": "Fotografía de marca con tratamiento duotono (tinta y verde) para que la imagen lleve color de marca."
    },
    {
      "name": "Menu",
      "group": "Navegación",
      "summary": "Menú desplegable anclado a un disparador."
    },
    {
      "name": "Pestanas",
      "group": "Navegación",
      "summary": "Pestañas para alternar vistas dentro de un bloque."
    },
    {
      "name": "Aviso",
      "group": "Retroalimentación",
      "summary": "Mensaje de estado en línea (formularios, cotizaciones), con filete superior de 2px en el color del estado."
    },
    {
      "name": "Ayuda",
      "group": "Retroalimentación",
      "summary": "Tooltip corto sobre tinta para explicar un término o un ícono."
    },
    {
      "name": "Dialogo",
      "group": "Retroalimentación",
      "summary": "Diálogo modal para confirmaciones y formularios cortos."
    },
    {
      "name": "Notificacion",
      "group": "Retroalimentación",
      "summary": "Notificación (toast) para confirmar acciones; posicionarla fija abajo a la izquierda."
    },
    {
      "name": "HeroWeb",
      "group": "Piezas",
      "summary": "Portada del sitio: texto en bloque liso a la izquierda y una pieza visual a la derecha sobre degradado de marca."
    },
    {
      "name": "Diapositiva",
      "group": "Piezas",
      "summary": "Lámina 16:9 para propuestas y presentaciones, con logo y pie de página fijos."
    },
    {
      "name": "PublicacionRedes",
      "group": "Piezas",
      "summary": "Plantilla de publicación para redes: 1080×1080 o 1080×1920, con texto en bloque liso e isotipo."
    },
    {
      "name": "TarjetaPresentacion",
      "group": "Piezas",
      "summary": "Tarjeta de presentación de 89×51 mm: frente claro con datos y reverso en degradado profundo con logo."
    },
    {
      "name": "Panel",
      "group": "Aplicaciones",
      "summary": "Estructura de panel de aplicación: barra lateral en tinta de 200 px, cabecera de vista y contenido."
    },
    {
      "name": "Metrica",
      "group": "Aplicaciones",
      "summary": "Indicador de una cifra con su variación; la barra de marca arriba marca el bloque."
    },
    {
