  {
   "es": "<span class=\"p\" style=\"--i: 0\">Casi</span> <span class=\"p\" style=\"--i: 1\">todo</span> <span class=\"p\" style=\"--i: 2\">se</span> <span class=\"p\" style=\"--i: 3\">puede</span> <span class=\"p\" style=\"--i: 4\">automatizar,</span> <span class=\"p p--acento\" style=\"--i: 5\">no</span> <span class=\"p p--acento\" style=\"--i: 6\">hay</span> <span class=\"p p--acento\" style=\"--i: 7\">motivo</span> <span class=\"p p--acento\" style=\"--i: 8\">para</span> <span class=\"p p--acento\" style=\"--i: 9\">no</span> <span class=\"p p--acento\" style=\"--i: 10\">intentarlo.</span>",
